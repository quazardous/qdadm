{
  "type": "object",
  "required": ["value"],
  "additionalProperties": false,
  "properties": {
    "value": { "type": "number", "description": "The value now" },
    "label": { "type": "string", "description": "What is counted, after the value: \"orders\"" },
    "badge": { "type": "string", "description": "A short word beside the value, in the card's status tone: \"5 urgent\"" },
    "delta": {
      "type": "object",
      "required": ["value"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number", "description": "The change over the period, signed" },
        "period": { "type": "string", "description": "The period: \"week\", \"vs yesterday\"" }
      }
    },
    "series": {
      "description": "The recent values, oldest first: one series (a list of numbers), or several, each { label, points, tone }",
      "anyOf": [
        { "type": "array", "items": { "type": "number" } },
        {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["points"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "description": "Its name: \"in\", \"out\"" },
              "points": {
                "type": "array",
                "items": {
                  "anyOf": [
                    { "type": "number" },
                    { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": ["string", "number"] } },
                    {
                      "type": "object",
                      "required": ["v"],
                      "additionalProperties": false,
                      "properties": { "t": { "type": ["string", "number"] }, "v": { "type": "number" }, "low": { "type": "number" }, "high": { "type": "number" } }
                    }
                  ]
                }
              },
              "tone": { "type": ["string", "integer"], "description": "A status tone, or a palette rank (1 to 6)" }
            }
          }
        }
      ]
    },
    "hot": {
      "type": "array",
      "description": "The items behind the number that need a look",
      "items": {
        "type": "object",
        "required": ["label"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string" },
          "tag": { "type": "string", "description": "A short word on the right: \"urgent\"" },
          "tagStatus": { "type": "string", "enum": ["critical", "watch", "good", "info"] },
          "to": { "type": ["string", "object"], "description": "The item's route" }
        }
      }
    }
  }
}
