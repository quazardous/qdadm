# Copy to .env and fill in from the Google Cloud console.
#
#   APIs & Services -> Credentials -> Create credentials
#   -> OAuth client ID -> Web application
#
# Register this redirect URI EXACTLY, including the port:
#
#   http://localhost:5176/auth/google/callback
#
# .env is gitignored; .env.example is not. Never commit the secret.

# Not a secret — it ships in the front-end bundle.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# A secret. Backend only, never in a bundle, never in a commit.
GOOGLE_CLIENT_SECRET=your-client-secret
